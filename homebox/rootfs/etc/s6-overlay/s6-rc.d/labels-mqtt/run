#!/command/with-contenv bashio
# shellcheck shell=bash
set -o pipefail

WATCH_DIR="/data/homebox/labels"
MQTT_HOST="$(bashio::config 'mqtt_host')"
MQTT_PORT="$(bashio::config 'mqtt_port' '1883')"
MQTT_TOPIC="$(bashio::config 'mqtt_topic' 'homebox/labels')"
MQTT_USERNAME="$(bashio::config 'mqtt_username')"
MQTT_PASSWORD="$(bashio::config 'mqtt_password')"

if [ "$(bashio::config 'label_maker_enabled' 'false')" != "true" ]; then
    bashio::log.info "Label MQTT publishing is disabled."
    while :; do sleep 3600; done
fi

if [ -z "${MQTT_HOST}" ]; then
    bashio::log.error "Label MQTT publishing is enabled but mqtt_host is empty."
    while :; do sleep 3600; done
fi

mkdir -p "${WATCH_DIR}"
bashio::log.info "Watching ${WATCH_DIR} for PNG labels; publishing to ${MQTT_TOPIC}"

inotifywait --monitor --event close_write,moved_to --format '%w%f' "${WATCH_DIR}" |
while IFS= read -r FILE; do
    case "${FILE}" in
        *.png|*.PNG)
            [ -f "${FILE}" ] || continue
            bashio::log.info "Publishing label ${FILE} to MQTT"
            if [ -n "${MQTT_USERNAME}" ]; then
                mosquitto_pub -h "${MQTT_HOST}" -p "${MQTT_PORT}" \
                    -u "${MQTT_USERNAME}" -P "${MQTT_PASSWORD}" \
                    -t "${MQTT_TOPIC}" --retain -f "${FILE}"
            else
                mosquitto_pub -h "${MQTT_HOST}" -p "${MQTT_PORT}" \
                    -t "${MQTT_TOPIC}" --retain -f "${FILE}"
            fi
            ;;
    esac
done
